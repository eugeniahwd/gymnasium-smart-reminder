# ============================================================
# Gymnasium Smart Reminder — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke Git.
# ============================================================

# --- Google Gemini API ---
# Key dari https://aistudio.google.com (project TANPA billing = free tier). Hanya kirim data synthetic.
GEMINI_API_KEY=your_gemini_api_key_here
# Kosong -> default di src/api/config.py (DEFAULT_GEMINI_MODEL)
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional (nilai default):
# GEMINI_TEMPERATURE=0.7
# GEMINI_TIMEOUT_SECONDS=20
# GEMINI_MAX_RETRIES=2

# --- Database (PostgreSQL via Supabase) ---
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432, mendukung IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- FastAPI Backend ---
# URL UI Streamlit yang boleh mengakses API dari browser (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# --- UI Streamlit (lokal) ---
# Di Streamlit Community Cloud diisi lewat Secrets (lihat .streamlit/secrets.toml.example)
API_BASE_URL=http://localhost:8000
