# ============================================================
# Gymnasium Smart Reminder — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke Git.
# ============================================================

# --- Google Gemini API ---
# Key dari https://aistudio.google.com (project TANPA billing = free tier). Hanya kirim data synthetic.
GEMINI_API_KEY=your_gemini_api_key_here
# Kosong -> default di src/api/config.py (DEFAULT_GEMINI_MODEL)
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional (nilai default):
# GEMINI_TEMPERATURE=0.7
# GEMINI_TIMEOUT_SECONDS=20
# GEMINI_MAX_RETRIES=2

# --- Database (PostgreSQL via Supabase) ---
DATABASE_URL=postgresql://postgres.qkfrdteruthhwqsmwvti:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- FastAPI Backend ---
API_BASE_URL=http://localhost:8000
