# Contoh secrets Streamlit. Salin menjadi .streamlit/secrets.toml untuk lokal (JANGAN di-commit).
# Di Streamlit Community Cloud, isi lewat App settings -> Secrets. Panduan: docs/DEPLOYMENT.md

# --- Opsi A (dipakai): entrypoint streamlit_app.py, API dinyalakan di dalam aplikasi ---
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
GEMINI_API_KEY = "<api-key-dari-google-ai-studio>"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# --- Opsi B: entrypoint src/ui/app.py + API terpisah (mis. Render). Isi HANYA untuk opsi ini. ---
# API_BASE_URL = "https://<url-api>"
